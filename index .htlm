<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sanal Halı Mağazam - AR Deneyimi</title>
    
    <!-- Google Model-Viewer Kütüphanesi -->
    <script type="module" src="https://ajax.googleapis.com/ajax/libs/model-viewer/3.5.0/model-viewer.min.js"></script>
    
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 20px;
            background-color: #f4f4f9;
            text-align: center;
        }
        h1 { color: #333; }
        .product-card {
            background: white;
            border-radius: 8px;
            padding: 20px;
            max-width: 400px;
            margin: 20px auto;
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }
        model-viewer {
            width: 100%;
            height: 350px;
            background-color: #eee;
            border-radius: 8px;
        }
        /* AR Butonunu Özelleştirme */
        #ar-button {
            background-color: #2b6cb0;
            color: white;
            border: none;
            padding: 12px 20px;
            border-radius: 5px;
            font-size: 16px;
            cursor: pointer;
            margin-top: 15px;
            width: 100%;
        }
        #ar-button:hover {
            background-color: #2c5282;
        }
    </style>
</head>
<body>

    <h1>Evim için Sanal Halı</h1>
    <p>Telefonunuzdan "Odamda Gör" butonuna basarak halıyı odanıza yerleştirin.</p>

    <!-- Halı Ürün Kartı -->
    <div class="product-card">
        <h3>Modern Salon Halısı</h3>
        
        <!-- model-viewer etiketi (src kısmına kendi .glb dosyanın adını veya linkini yazacaksın) -->
        <model-viewer 
            src="hali1.glb" 
            ar 
            ar-modes="scene-viewer quick-look webxr" 
            camera-controls 
            auto-rotate
            shadow-intensity="1" 
            alt="Sanal Halı">
            
            <button slot="ar-button" id="ar-button">
                📱 Odanızda Canlı Gör (AR)
            </button>
        </model-viewer>
    </div>

</body>
</html>